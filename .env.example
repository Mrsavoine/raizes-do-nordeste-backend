# Copie para .env e ajuste. NUNCA versione o arquivo .env.
# Segredo do JWT: mínimo 32 caracteres. Gere um valor próprio, p.ex.: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=troque-este-valor-por-um-segredo-aleatorio-com-48-caracteres
JWT_EXPIRES_SECONDS=3600
DATABASE_PATH=raizes.db
HOST=127.0.0.1
PORT=8080
# Aplica dados de demonstração (usuários/produtos) na primeira execução
SEED_ON_START=true
# Permite o campo "simulacao" (APROVADO/RECUSADO/FALHA) no pagamento mock. Desative fora de ambiente de testes.
MOCK_PAYMENT_ALLOW_SIMULATION=true
