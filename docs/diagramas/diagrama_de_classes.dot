digraph Classes { rankdir=LR; nodesep=0.5; ranksep=0.9; node [shape=plaintext fontname="Helvetica" fontsize=10]; edge [fontname="Helvetica" fontsize=9 color="#44546A"];
Unidade [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#1F3864"><FONT COLOR="white"><B>Unidade</B></FONT></TD></TR><TR><TD ALIGN="LEFT">+ id: int</TD></TR><TR><TD ALIGN="LEFT">+ nome: str</TD></TR><TR><TD ALIGN="LEFT">+ cidade: str</TD></TR><TR><TD ALIGN="LEFT">+ uf: str</TD></TR><TR><TD ALIGN="LEFT">+ ativa: bool</TD></TR><TR><TD ALIGN="LEFT">+ criado_em: str</TD></TR><TR><TD> </TD></TR></TABLE>>];
Usuario [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#1F3864"><FONT COLOR="white"><B>Usuario</B></FONT></TD></TR><TR><TD ALIGN="LEFT">+ id: int</TD></TR><TR><TD ALIGN="LEFT">+ nome: str</TD></TR><TR><TD ALIGN="LEFT">+ email: str</TD></TR><TR><TD ALIGN="LEFT">+ senha_hash: str</TD></TR><TR><TD ALIGN="LEFT">+ perfil: str</TD></TR><TR><TD ALIGN="LEFT">+ unidade_id: Optional[int]</TD></TR><TR><TD ALIGN="LEFT">+ ativo: bool</TD></TR><TR><TD ALIGN="LEFT">+ criado_em: str</TD></TR><TR><TD ALIGN="LEFT">+ eh_equipe()</TD></TR></TABLE>>];
Produto [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#1F3864"><FONT COLOR="white"><B>Produto</B></FONT></TD></TR><TR><TD ALIGN="LEFT">+ id: int</TD></TR><TR><TD ALIGN="LEFT">+ nome: str</TD></TR><TR><TD ALIGN="LEFT">+ descricao: Optional[str]</TD></TR><TR><TD ALIGN="LEFT">+ preco_base_centavos: int</TD></TR><TR><TD ALIGN="LEFT">+ ativo: bool</TD></TR><TR><TD ALIGN="LEFT">+ criado_em: str</TD></TR><TR><TD> </TD></TR></TABLE>>];
ItemCardapio [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#1F3864"><FONT COLOR="white"><B>ItemCardapio</B></FONT></TD></TR><TR><TD ALIGN="LEFT">+ unidade_id: int</TD></TR><TR><TD ALIGN="LEFT">+ produto_id: int</TD></TR><TR><TD ALIGN="LEFT">+ preco_centavos: int</TD></TR><TR><TD ALIGN="LEFT">+ disponivel: bool</TD></TR><TR><TD> </TD></TR></TABLE>>];
Promocao [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#1F3864"><FONT COLOR="white"><B>Promocao</B></FONT></TD></TR><TR><TD ALIGN="LEFT">+ id: int</TD></TR><TR><TD ALIGN="LEFT">+ codigo: str</TD></TR><TR><TD ALIGN="LEFT">+ descricao: str</TD></TR><TR><TD ALIGN="LEFT">+ percentual: int</TD></TR><TR><TD ALIGN="LEFT">+ valor_minimo_centavos: int</TD></TR><TR><TD ALIGN="LEFT">+ ativa: bool</TD></TR><TR><TD ALIGN="LEFT">+ valido_ate: Optional[str]</TD></TR><TR><TD ALIGN="LEFT">+ criado_em: str</TD></TR><TR><TD ALIGN="LEFT">+ calcular_desconto(subtotal, agora)</TD></TR></TABLE>>];
ItemPedido [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#1F3864"><FONT COLOR="white"><B>ItemPedido</B></FONT></TD></TR><TR><TD ALIGN="LEFT">+ produto_id: int</TD></TR><TR><TD ALIGN="LEFT">+ quantidade: int</TD></TR><TR><TD ALIGN="LEFT">+ preco_unitario_centavos: int</TD></TR><TR><TD ALIGN="LEFT">+ id: Optional[int]</TD></TR><TR><TD ALIGN="LEFT">+ pedido_id: Optional[int]</TD></TR><TR><TD ALIGN="LEFT">+ subtotal_centavos (property)</TD></TR></TABLE>>];
Pedido [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#1F3864"><FONT COLOR="white"><B>Pedido</B></FONT></TD></TR><TR><TD ALIGN="LEFT">+ id: Optional[int]</TD></TR><TR><TD ALIGN="LEFT">+ cliente_id: int</TD></TR><TR><TD ALIGN="LEFT">+ unidade_id: int</TD></TR><TR><TD ALIGN="LEFT">+ canal_pedido: str</TD></TR><TR><TD ALIGN="LEFT">+ status: str</TD></TR><TR><TD ALIGN="LEFT">+ subtotal_centavos: int</TD></TR><TR><TD ALIGN="LEFT">+ desconto_centavos: int</TD></TR><TR><TD ALIGN="LEFT">+ total_centavos: int</TD></TR><TR><TD ALIGN="LEFT">+ promocao_id: Optional[int]</TD></TR><TR><TD ALIGN="LEFT">+ forma_pagamento: str</TD></TR><TR><TD ALIGN="LEFT">+ criado_em: str</TD></TR><TR><TD ALIGN="LEFT">+ atualizado_em: str</TD></TR><TR><TD ALIGN="LEFT">+ itens: list[ItemPedido]</TD></TR><TR><TD ALIGN="LEFT">+ pode_transitar_para(novo)</TD></TR><TR><TD ALIGN="LEFT">+ validar_transicao(novo)</TD></TR></TABLE>>];
Perfil [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#7F7F7F"><FONT COLOR="white"><I>«enum» Perfil</I></FONT></TD></TR><TR><TD ALIGN="LEFT">CLIENTE</TD></TR><TR><TD ALIGN="LEFT">ATENDENTE</TD></TR><TR><TD ALIGN="LEFT">COZINHA</TD></TR><TR><TD ALIGN="LEFT">GERENTE</TD></TR><TR><TD ALIGN="LEFT">ADMIN</TD></TR></TABLE>>];
CanalPedido [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#7F7F7F"><FONT COLOR="white"><I>«enum» CanalPedido</I></FONT></TD></TR><TR><TD ALIGN="LEFT">APP</TD></TR><TR><TD ALIGN="LEFT">TOTEM</TD></TR><TR><TD ALIGN="LEFT">BALCAO</TD></TR><TR><TD ALIGN="LEFT">PICKUP</TD></TR><TR><TD ALIGN="LEFT">WEB</TD></TR></TABLE>>];
StatusPedido [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#7F7F7F"><FONT COLOR="white"><I>«enum» StatusPedido</I></FONT></TD></TR><TR><TD ALIGN="LEFT">AGUARDANDO_PAGAMENTO</TD></TR><TR><TD ALIGN="LEFT">PAGO</TD></TR><TR><TD ALIGN="LEFT">EM_PREPARO</TD></TR><TR><TD ALIGN="LEFT">PRONTO</TD></TR><TR><TD ALIGN="LEFT">ENTREGUE</TD></TR><TR><TD ALIGN="LEFT">CANCELADO</TD></TR><TR><TD ALIGN="LEFT">PAGAMENTO_RECUSADO</TD></TR></TABLE>>];
StatusPagamento [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#7F7F7F"><FONT COLOR="white"><I>«enum» StatusPagamento</I></FONT></TD></TR><TR><TD ALIGN="LEFT">APROVADO</TD></TR><TR><TD ALIGN="LEFT">RECUSADO</TD></TR><TR><TD ALIGN="LEFT">FALHA</TD></TR></TABLE>>];
TipoMovimento [label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0"><TR><TD BGCOLOR="#7F7F7F"><FONT COLOR="white"><I>«enum» TipoMovimento</I></FONT></TD></TR><TR><TD ALIGN="LEFT">ENTRADA</TD></TR><TR><TD ALIGN="LEFT">SAIDA</TD></TR></TABLE>>];
Pedido -> ItemPedido [label="compõe" taillabel="1" headlabel="1..*" arrowhead=none arrowtail=diamond dir=back];
Pedido -> Promocao [label="aplica" taillabel="0..*" headlabel="0..1" arrowhead=vee];
Pedido -> Usuario [label="cliente" taillabel="0..*" headlabel="1" arrowhead=vee];
Pedido -> Unidade [label="feito em" taillabel="0..*" headlabel="1" arrowhead=vee];
Usuario -> Unidade [label="lotado em" taillabel="0..*" headlabel="0..1" arrowhead=vee];
ItemCardapio -> Unidade [label="cardápio de" taillabel="0..*" headlabel="1" arrowhead=vee];
ItemCardapio -> Produto [label="precifica" taillabel="0..*" headlabel="1" arrowhead=vee];
ItemPedido -> Produto [label="refere" taillabel="0..*" headlabel="1" arrowhead=vee];
Usuario -> Perfil [style=dashed arrowhead=open label="usa"];
Pedido -> CanalPedido [style=dashed arrowhead=open label="usa"];
Pedido -> StatusPedido [style=dashed arrowhead=open label="usa"];
}